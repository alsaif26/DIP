    "# 02 Pixel Matrix 10X10\n",
    "প্রতিটি Run করলে আলাদাভাবে image upload করা যাবে।"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "import cv2\n",
    "\n",
    "file = files.upload()\n",
    "name = list(file.keys())[0]\n",
    "\n",
    "image = cv2.imread(name, 0)\n",
    "\n",
    "print(\"10 x 10 Pixel Matrix:\")\n",
    "print(image[0:10, 0:10])"
   ]
  }
